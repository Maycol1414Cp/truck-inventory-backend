# Configuración del Servidor Express 5
NODE_ENV=production
PORT=8080

# Configuración para Supabase PostgreSQL Connection Pooler (Supavisor)
# - Usa puerto 6543 (Transaction Mode) en Google Cloud Run
# - Usa puerto 5432 (Session Mode) al ejecutar `pnpm migrate` o `pnpm seed`
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.tu_project_ref
DB_PASSWORD=tu_password_seguro_de_supabase
DB_NAME=postgres
DB_POOL_MAX=5
DB_SSL=true
