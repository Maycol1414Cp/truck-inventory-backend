{
  "name": "backend-inventario-truck-parts",
  "version": "1.0.0",
  "description": "Sistema integral de inventarios multi-sucursal y POS para repuestos de camiones",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "migrate": "node src/database/runMigration.js",
    "seed": "node src/database/seeds/runSeed.js",
    "lint": "node --check src/app.js src/config/database.js src/database/runMigration.js src/database/seeds/runSeed.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1"
  },
  "keywords": [
    "inventory",
    "pos",
    "truck-parts",
    "express5",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@scalar/express-api-reference": "^0.10.29",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "1.4.5-lts.2",
    "pg": "^8.21.0",
    "sharp": "^0.33.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
